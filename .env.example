# =============================================================================
# PrioritySignal – City Dashboard Environment Variables
# =============================================================================

# 1. Gemini AI (Server-side only — never exposed to client bundles)
# AI Studio automatically injects this from secrets, or set on Vercel
GEMINI_API_KEY="your-gemini-api-key"

# 2. Host Application URL
APP_URL="https://your-prioritysignal-deployment.vercel.app"

# 3. Supabase PostgreSQL Configuration (Server-side only)
# SUPABASE_URL: The HTTPS URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_SECRET_KEY: The service_role secret key for server-side administration and RLS bypass
# CRITICAL: Keep strictly server-side. Never expose in frontend bundles or logs.
SUPABASE_SECRET_KEY="your-service-role-secret-key"

# SUPABASE_PUBLISHABLE_KEY: The public anon key for client-safe read queries if used
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# 4. CARTO Basemap (Client-side via Vite — safe public key for dark_all map tiles)
# VITE_CARTO_API_KEY: Your CARTO API key for high-throughput raster basemap tiles
VITE_CARTO_API_KEY="your-carto-api-key"
